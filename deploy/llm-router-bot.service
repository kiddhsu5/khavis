[Unit]
Description=llm-router Telegram dispatch bot (polling mode)
Documentation=https://github.com/kiddhsu5/llm-router
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/llm-router-bot
EnvironmentFile=/root/llm-router-bot/.env
Environment=BOT_MODE=polling
ExecStart=/root/llm-router-bot/.venv/bin/python -m bot.main --mode polling
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=llm-router-bot

# Harden a little even though we run as root (single-user VPS).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/root/llm-router-bot/memory /root/llm-router-bot/logs

[Install]
WantedBy=multi-user.target
