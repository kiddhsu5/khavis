# Example environment file for the llm-router Telegram bot.
# Copy to `.env` at the project root and fill in real values.
#
# All values below are read by `bot.secrets.BotSecrets.from_env()` and
# `docker-compose.yml`. NEVER commit a populated .env.

# ----- Required -----
BOT_TOKEN=                              # from @BotFather
WEBHOOK_SECRET=                         # optional; defaults to BOT_TOKEN
ALLOWED_CHAT_IDS=                       # comma-separated integer chat IDs allowed to invoke the bot

# ----- Optional -----
# BOT_MODE=webhook                        # or "polling" for local / no-public-endpoint setups
# BOT_HOST=0.0.0.0
# BOT_PORT=8080
# BACKEND_TIMEOUT_S=180
# LONG_POLL_TIMEOUT_S=30

# Restrict which backends `/run` fans out to when no --only flag is
# given. Comma-separated subset of: claude, codex, llm-router.
# Unset / empty = all three. Useful to skip a backend that's
# temporarily unauthenticated (e.g. claude before OAuth login).
# BOT_BACKENDS=codex,llm-router

# Backend-specific defaults — leave empty to use each CLI's own default.
# CLAUDE_DISPATCH_MODEL=
# CODEX_DISPATCH_MODEL=

# For pair-loader (optional, points at the historical telegram-pairing.json)
# TELEGRAM_PAIRING_PATH=/path/to/telegram-pairing.json