# llm-router environment variables
#
# Copy this file to .env and fill in the keys you have access to. Pools
# whose env var is left blank are gracefully skipped by the integration
# test runner (`scripts/integration_test.py`).

# --- MiniMax-M3 (MiniMax Chat, OpenAI-compatible) -----------------
# Used by providers/MiniMax.py
MiniMax_API_KEY=

# --- GLM-5.3 (ZhipuAI / BigModel) ---------------------------------
# Used by providers/glm.py
ZHIPUAI_API_KEY=

# --- Google Gemini (Flash + Pro) -----------------------------------
# Single key serves both gemini-flash-latest and gemini-pro-latest.
# Used by providers/gemini.py
GOOGLE_API_KEY=

# --- NVIDIA Cloud (NIM) --------------------------------------------
# Used by providers/nvidia.py
NVIDIA_API_KEY=

# --- Volcano Ark (ByteDance) ---------------------------------------
# Shared by DeepSeek-V4-Pro, DeepSeek-V4.1-Flash, GLM-5.3-Flash.
# Used by providers/volcano.py
BYTEDANCE_API_KEY=

# --- OpenRouter (free tier) ----------------------------------------
# Used by providers/openrouter.py
OPENROUTER_API_KEY=

# --- OpenAI Platform API (BYOK) ------------------------------------
# Separate from ChatGPT Plus/GO subscriptions. Sign up at
# https://platform.openai.com/api-keys. Used by providers/openai.py.
OPENAI_API_KEY=

# --- Anthropic Claude API (BYOK) -----------------------------------
# Separate from Claude Code or Cursor subscriptions. Sign up at
# https://console.anthropic.com. Used by providers/claude.py.
ANTHROPIC_API_KEY=

# --- Ollama (no auth, local HTTP) ----------------------------------
# Mac pool talks to http://localhost:11434 by default.
# Surface pool reads SURFACE_IP to build http://$SURFACE_IP:11434.
# Tip: run `bash scripts/setup_ollama.sh --surface --ip <addr>` to set this automatically.
SURFACE_IP=
